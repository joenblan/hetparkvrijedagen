<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=1920, initial-scale=1">
<title>Vrije dagen {{ schooljaar }}</title>
<!-- General Sans is het huislettertype. Laadt die niet, dan valt de pagina
     terug op Arial, precies zoals de skin van de site zelf doet. -->
<link rel="preconnect" href="https://api.fontshare.com" crossorigin>
<link rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap">
<style>
/* Kleuren komen uit skin-bshetpark.css:
   color1 = teal (#009886 / #027265 / #004d44 / #55c5b8)
   color2 = limoen (#a1d683)
   Op een scherm in de gang leest lichte tekst op diep teal rustiger dan
   zwart op wit, en het blijft herkenbaar de huisstijl. */
:root {
  --merk-diep: #004d44;
  --merk-paneel: #00655a;
  --merk-teal: #009886;
  --lijn: rgba(220, 248, 244, 0.18);
  --tekst: #ffffff;
  --gedempt: #9ecfc7;

  --vakantie: #a1d683;   /* color2-base */
  --feestdag: #55c5b8;   /* color1-light */
  --studiedag: #ffffff;  /* door de school zelf gekozen: sterkste accent */
  --facultatief: #ffffff;
  --vrije-dag: #ffffff;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: 100%; height: 100%;
  overflow: hidden;
  cursor: none;
  background: var(--merk-diep);
  color: var(--tekst);
  font-family: "General Sans", "GeneralSans", Arial, Helvetica,
               "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* Alles in vh, het scherm is 16:9, dus dit schaalt mee met elke resolutie
   met die verhouding. Ontworpen voor 1920x1080. */
#scherm {
  width: 100%; height: 100%;
  display: grid;
  grid-template-rows: 12vh 1fr 5vh;
  padding: 0 4vh;
  will-change: transform;
}

header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 5vh;
  border-bottom: 0.3vh solid var(--merk-teal);
}
header .merk { font-size: 2.2vh; color: var(--gedempt); margin-bottom: 0.4vh; }
header .titel { font-size: 3.6vh; font-weight: 600; letter-spacing: -0.015em; }
header .vandaag {
  font-size: 3vh;
  color: var(--gedempt);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

main {
  display: grid;
  grid-template-columns: 37% minmax(0, 1fr);
  gap: 5vh;
  padding: 5vh 0;
  min-height: 0;
}

/* ---- links: de eerstvolgende vrije dag ---- */
#hero {
  background: var(--merk-paneel);
  border-left: 1vh solid var(--accent, var(--vakantie));
  padding: 5vh 4vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}
#hero .aanloop { font-size: 2.8vh; color: var(--gedempt); margin-bottom: 1.5vh; }
#hero .teller {
  font-size: 10vh;
  line-height: 1.02;
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--accent, var(--vakantie));
  margin-bottom: 3vh;
}
#hero .teller.kort { font-size: 8.5vh; }
#hero .naam {
  font-size: 5.2vh;
  line-height: 1.1;
  font-weight: 600;
  letter-spacing: -0.015em;
  overflow-wrap: anywhere;
}
#hero .naam.lang { font-size: 4.2vh; }
#hero .wanneer { font-size: 3.2vh; color: var(--gedempt); margin-top: 1.5vh; }

/* ---- rechts: de rest van het schooljaar ---- */
#daarna { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
#daarna h2 {
  font-size: 2.6vh;
  font-weight: 600;
  color: var(--gedempt);
  padding-bottom: 1.5vh;
  border-bottom: 0.2vh solid var(--lijn);
}

/* De datumkolom staat op 'max-content': ze wordt precies zo breed als de
   langste datum in de lijst ("ma 21 dec - zo 3 jan"). Daardoor kan tekst
   nooit over de naamkolom heen vallen, hoe lang de datum ook wordt. De li's
   staan op display:contents zodat beide cellen in hetzelfde raster liggen en
   alle datums netjes onder elkaar uitkomen. */
#lijst {
  list-style: none;
  display: grid;
  grid-template-columns: max-content minmax(0, 1fr);
  align-content: start;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
#lijst li { display: contents; }
#lijst .datum {
  grid-column: 1;
  padding: 2vh 3vh 2vh 2vh;
  border-left: 0.5vh solid var(--accent);
  border-bottom: 0.2vh solid var(--lijn);
  font-size: 3.2vh;
  color: var(--accent);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
#lijst .naam {
  grid-column: 2;
  padding: 2vh 0;
  border-bottom: 0.2vh solid var(--lijn);
  font-size: 3.4vh;
  font-weight: 500;
  min-width: 0;
  overflow-wrap: anywhere;
}
#lijst .noot { color: var(--gedempt); font-weight: 400; font-size: 2.6vh; }
#meer { font-size: 2.6vh; color: var(--gedempt); padding-top: 2vh; }

#leeg {
  grid-column: 1 / -1;
  align-self: center;
  text-align: center;
  font-size: 5vh;
  color: var(--gedempt);
}

footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 1.9vh;
  color: var(--lijn);
  border-top: 0.2vh solid var(--lijn);
}
</style>
</head>
<body>

<div id="scherm">
  <header>
    <div>
      {% if school_naam %}<div class="merk">{{ school_naam }}</div>{% endif %}
      <div class="titel">Vrije dagen schooljaar {{ schooljaar }}</div>
    </div>
    <div class="vandaag" id="vandaag"></div>
  </header>

  <main id="inhoud"></main>

  <footer>Kalender bijgewerkt op {{ bijgewerkt_op }}</footer>
</div>

<script>
const DATA = {{ data_json | safe }};

// Hoeveel regels er rechts passen. Meer dan 7 wordt op 1080 te krap.
const MAX_REGELS = 7;
// Elke 30 minuten de pagina opnieuw ophalen, zodat een nieuwe build binnenkomt.
const HERLAAD_MS = 30 * 60 * 1000;

const KLEUR = {
  vakantie: "var(--vakantie)",
  feestdag: "var(--feestdag)",
  studiedag: "var(--studiedag)",
  facultatief: "var(--facultatief)",
  "vrije-dag": "var(--vrije-dag)",
};

const WEEKDAGEN = ["zondag", "maandag", "dinsdag", "woensdag", "donderdag",
                   "vrijdag", "zaterdag"];
const MAANDEN = ["januari", "februari", "maart", "april", "mei", "juni", "juli",
                 "augustus", "september", "oktober", "november", "december"];

function alsDatum(iso) {
  const [j, m, d] = iso.split("-").map(Number);
  return new Date(j, m - 1, d);
}
function vandaag() {
  const n = new Date();
  return new Date(n.getFullYear(), n.getMonth(), n.getDate());
}
function dagenTussen(a, b) {
  return Math.round((b - a) / 86400000);
}
function esc(s) {
  return String(s).replace(/[&<>"]/g, c =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
}

function teken() {
  const nu = vandaag();
  document.getElementById("vandaag").textContent =
    WEEKDAGEN[nu.getDay()] + " " + nu.getDate() + " " + MAANDEN[nu.getMonth()];

  const komend = DATA.items.filter(i => alsDatum(i.eind) >= nu);
  const inhoud = document.getElementById("inhoud");

  if (komend.length === 0) {
    inhoud.innerHTML = '<p id="leeg">Geen vrije dagen meer dit schooljaar.</p>';
    return;
  }

  // Een feestdag die volledig in het weekend valt is geen extra vrije dag en
  // hoort dus niet groot in beeld. In de lijst blijft hij wel staan.
  const hero = komend.find(i => !i.enkel_weekend) || komend[0];
  const rest = komend.filter(i => i !== hero);

  const kleur = KLEUR[hero.categorie] || "var(--vakantie)";
  const start = alsDatum(hero.start);
  const eind = alsDatum(hero.eind);

  let aanloop, teller, kortTeller = false;
  if (start <= nu) {
    const over = dagenTussen(nu, eind) + 1;
    aanloop = "Nu bezig";
    teller = over === 1 ? "Laatste dag" : "Nog " + over + " dagen";
    kortTeller = over === 1;
  } else {
    const tot = dagenTussen(nu, start);
    aanloop = "Eerstvolgende vrije dag";
    teller = tot === 1 ? "Morgen" : "Nog " + tot + " dagen";
  }

  let html =
    '<section id="hero" style="--accent:' + kleur + '">' +
      '<p class="aanloop">' + aanloop + '</p>' +
      '<p class="teller' + (kortTeller ? " kort" : "") + '">' + teller + '</p>' +
      '<p class="naam' + (hero.naam.length > 28 ? " lang" : "") + '">' +
        esc(hero.naam) + '</p>' +
      '<p class="wanneer">' + esc(hero.periode) + '</p>' +
    '</section>';

  html += '<section id="daarna"><h2>Daarna dit schooljaar</h2><ul id="lijst">';
  rest.slice(0, MAX_REGELS).forEach(i => {
    const c = KLEUR[i.categorie] || "var(--vakantie)";
    html +=
      '<li style="--accent:' + c + '">' +
        '<span class="datum">' + esc(i.kort) + '</span>' +
        '<span class="naam">' + esc(i.naam) +
          (i.enkel_weekend
            ? '<span class="noot"> \u00b7 valt in het weekend</span>' : '') +
        '</span>' +
      '</li>';
  });
  html += '</ul>';
  const over = rest.length - MAX_REGELS;
  if (over > 0) {
    html += '<p id="meer">En nog ' + over +
            (over === 1 ? ' vrije periode' : ' vrije periodes') +
            ' later dit schooljaar.</p>';
  }
  html += '</section>';

  inhoud.innerHTML = html;
}

// Een scherm dat maandenlang hetzelfde toont brandt in. Elke vijf minuten
// een paar pixels opschuiven is genoeg om dat te voorkomen.
const SCHUIF = [[0, 0], [2, 1], [3, 0], [2, -1], [0, -2], [-2, -1], [-3, 0], [-2, 1]];
let schuifIndex = 0;
function pixelShift() {
  const [x, y] = SCHUIF[schuifIndex % SCHUIF.length];
  document.getElementById("scherm").style.transform =
    "translate(" + x + "px," + y + "px)";
  schuifIndex++;
}

teken();
pixelShift();
// Elke minuut opnieuw tekenen, zodat de teller om middernacht meeschuift ook
// als de pagina al dagen openstaat.
setInterval(teken, 60 * 1000);
setInterval(pixelShift, 5 * 60 * 1000);
setTimeout(() => location.reload(), HERLAAD_MS);
</script>

</body>
</html>
